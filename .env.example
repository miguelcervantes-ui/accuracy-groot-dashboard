# ID de la hoja de Google Sheets (ya incluido por defecto, cámbialo si usas otra hoja)
SPREADSHEET_ID=1-CLaIvryfo2cw9mPuqwJ1A_i2dBSBRfSt_b7FRYWITM

# Nombre de la pestaña dentro del Sheets
SHEET_NAME=Datos

# Credenciales de la Service Account de Google (JSON en una sola línea)
# Pasos:
#   1. Ve a https://console.cloud.google.com → APIs & Services → Credentials
#   2. Crea una Service Account y descarga la clave JSON
#   3. Comparte el Sheets con el email de la Service Account (solo lectura)
#   4. Pega aquí el contenido completo del JSON (sin saltos de línea)
GOOGLE_SERVICE_ACCOUNT_KEY={"type":"service_account","project_id":"..."}

# Email del usuario que aparece en el header (opcional)
USER_EMAIL=miguel.cervantes@mercadolibre.com.mx

# Puerto del servidor (opcional, default 3000)
PORT=3000
